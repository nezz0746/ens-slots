# Alchemy Prices API key, for showing slot figures in dollars.
# Server-side only: it is read by /api/price and never reaches the browser.
# Without it the app works and simply shows no dollar amounts.
ALCHEMY_API_KEY=

# The origin this deployment is served from, used to make the Open Graph image
# URLs absolute. Without it they point at localhost and no crawler can fetch them.
NEXT_PUBLIC_SITE_URL=
